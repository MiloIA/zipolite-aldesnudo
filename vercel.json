{
  "functions": {
    "api/pagos.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' 'unsafe-inline' 'unsafe-eval' https: data: blob:;"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/mi-reserva", "destination": "/mi-reserva.html" },
    { "source": "/mi-cuenta", "destination": "/mi-cuenta.html" }
  ],
  "crons": [
    {
      "path": "/api/crm-agent",
      "schedule": "0 16 * * 1-6"
    }
  ]
}

{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' 'unsafe-inline' 'unsafe-eval' https: data: blob:;"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/crm-agent",
      "schedule": "0 16 * * 1-6"
    }
  ]
}
